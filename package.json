{
  "name": "x-exchange-uniapp",
  "version": "1.0.0",
  "description": "X交易所Uniapp多端应用",
  "main": "main.ts",
  "scripts": {
    "serve": "npm run dev:h5",
    "build": "npm run build:h5",
    "build:app": "uni build --platform app --manifest ./manifest.json",
    "build:h5": "uni build --platform h5",
    "build:mp-weixin": "uni build --platform mp-weixin",
    "build:mp-alipay": "uni build --platform mp-alipay",
    "dev:app": "uni serve --platform app",
    "dev:h5": "uni serve --platform h5",
    "dev:mp-weixin": "uni serve --platform mp-weixin",
    "dev:mp-alipay": "uni serve --platform mp-alipay",
    "info": "uni info",
    "lint": "eslint src/**/*.{js,ts,vue}",
    "lint:fix": "eslint src/**/*.{js,ts,vue} --fix",
    "type-check": "vue-tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4070620250821001",
    "@dcloudio/uni-app-plus": "3.0.0-4070620250821001",
    "@dcloudio/uni-components": "3.0.0-4070620250821001",
    "@dcloudio/uni-h5": "3.0.0-4070620250821001",
    "@dcloudio/uni-shared": "3.0.0-4070620250821001",
    "@vueuse/core": "^10.7.0",
    "dayjs": "^1.11.18",
    "echarts": "6.0.0",
    "html2canvas": "^1.4.1",
    "jwt-decode": "^4.0.0",
    "lodash-es": "^4.17.21",
    "pinia": "^2.3.1",
    "pinia-plugin-persistedstate": "^3.2.3",
    "uni-echarts": "2.0.1",
    "uqrcodejs": "4.0.7",
    "vue": "^3.4.0",
    "vue-i18n": "^9.8.0"
  },
  "devDependencies": {
    "@dcloudio/uni-cli-shared": "3.0.0-4070620250821001",
    "@dcloudio/vite-plugin-uni": "3.0.0-4070620250821001",
    "@types/jest": "^29.5.8",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.3",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.19.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "sass": "^1.69.7",
    "sass-loader": "^13.3.3",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3",
    "vue-tsc": "^1.8.27"
  },
  "browserslist": [
    "Android >= 4.4",
    "ios >= 9"
  ],
  "uni-app": {
    "scripts": {}
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "uniapp",
    "vue3",
    "typescript",
    "exchange",
    "trading"
  ],
  "author": "Winnie413",
  "license": "MIT",
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.ts"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.ts",
      "<rootDir>/tests/**/*.spec.ts"
    ],
    "moduleNameMapping": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "utils/**/*.ts",
      "store/**/*.ts",
      "api/**/*.ts",
      "components/**/*.vue",
      "!**/*.d.ts",
      "!**/node_modules/**",
      "!**/tests/**"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coverageDirectory": "<rootDir>/coverage",
    "transformIgnorePatterns": [
      "node_modules/(?!(lodash-es|@vueuse/core)/)"
    ]
  }
}
